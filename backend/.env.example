# ---------- Server ----------
PORT=3001
FRONTEND_ORIGIN=http://localhost:5173

# ---------- Database (matches docker-compose.yml) ----------
DATABASE_URL=postgresql://kw:kw@localhost:5432/kwdb?schema=public

# ---------- Google Gemini ----------
# Get a free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Run "npm run check:gemini" to confirm these model names are available for your key
GEMINI_CHAT_MODEL=gemini-2.5-flash
GEMINI_EMBED_MODEL=gemini-embedding-001

# ---------- Optional tuning ----------
# CHUNK_SIZE=1000
# CHUNK_OVERLAP=150
# TOP_K=5
# MIN_SCORE=0
# MAX_UPLOAD_MB=15
